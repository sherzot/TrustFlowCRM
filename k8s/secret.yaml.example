# NEVER commit real secrets. Copy this file to secret.yaml locally and fill
# the stringData values. Apply with:
#   kubectl apply -f k8s/secret.yaml
#
# Or generate from literals:
#   kubectl -n trustflow create secret generic trustflow-secrets \
#       --from-literal=APP_KEY=... \
#       --from-literal=DB_PASSWORD=... \
#       --from-literal=OPENAI_API_KEY=...
apiVersion: v1
kind: Secret
metadata:
  name: trustflow-secrets
  namespace: trustflow
type: Opaque
stringData:
  APP_KEY: "base64:REPLACE_ME"
  DB_USERNAME: "trustflow"
  DB_PASSWORD: "REPLACE_ME"
  OPENAI_API_KEY: "sk-REPLACE_ME"
  REVERB_APP_SECRET: "REPLACE_ME"
  MAIL_PASSWORD: "REPLACE_ME"
