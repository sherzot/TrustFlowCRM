# ----------------------------------------------------------------------------
# TrustFlow CRM — production .env template
#
# Copy this file to `.env.production` on the deploy host and fill in real
# values. NEVER commit `.env.production` — it contains secrets. This
# template is safe to commit because it only has placeholders.
#
# Regenerate APP_KEY with:
#     docker run --rm ghcr.io/sherzot/trustflowcrm:latest php artisan key:generate --show
# ----------------------------------------------------------------------------

APP_NAME="TrustFlow CRM"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---- Database (MySQL 8) ----------------------------------------------------
# DB_* are read by Laravel. MYSQL_* are read by the mysql:8.0 image on first
# boot to create the root user, database, and app user. Keep them aligned.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=trustflow_crm
DB_USERNAME=trustflow
DB_PASSWORD=CHANGE_ME_strong_db_password

MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_DATABASE=trustflow_crm
MYSQL_USER=trustflow
MYSQL_PASSWORD=CHANGE_ME_strong_db_password

# ---- Redis (cache / queue / session / broadcasting) ------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log

# ---- Mail ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_WITH_REAL_KEY

# ---- Filesystem ------------------------------------------------------------
FILESYSTEM_DISK=local

# ---- Optional: host port override ------------------------------------------
# Change if 8080 collides with something else on the host. Compose maps
# APP_PORT -> container:8080.
# APP_PORT=8080

# ---- Optional: image tag override ------------------------------------------
# Used by docker-compose.prod.yml / scripts/deploy.sh. Defaults to :latest.
# Pin a specific build for deterministic deploys / easy rollback.
# IMAGE_TAG=sha-abc1234
