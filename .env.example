APP_NAME="TrustFlow CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=trustflow_crm
DB_USERNAME=trustflow
DB_PASSWORD=root

# Sessions, cache and queue go through Redis in the upgraded stack.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=trustflow

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (local dev).
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@trustflowcrm.local"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (websockets).
REVERB_APP_ID=trustflow
REVERB_APP_KEY=trustflow_key
REVERB_APP_SECRET=trustflow_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OpenAI / AI layer.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# AI layer tuning (see config/ai.php).
AI_CACHE_TTL=900
AI_RL_LEAD_SCORING=60
AI_RL_DEAL_PREDICTION=60
AI_RL_RISK_DETECTION=60
AI_RL_CHURN_DETECTION=60
AI_RL_EMAIL_GENERATION=30
AI_RL_NLP=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

HORIZON_PREFIX=horizon
